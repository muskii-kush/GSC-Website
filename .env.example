# Hosted Postgres (Supabase, Neon, RDS…). Required in production.
# Leave unset locally to use the embedded database in ./.data
DATABASE_URL=

# Secret used to hash OTP codes. Required in production. Generate with: openssl rand -hex 32
OTP_SECRET=

# SMS provider for OTPs. Only "mock" exists today (logs the code, shows it in the form in dev).
SMS_PROVIDER=mock

# Show mock OTPs in the browser on a production build (staging only — never for a real launch).
ALLOW_MOCK_OTP_ECHO=false
